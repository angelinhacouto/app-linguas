{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "expo",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_expo|heroes|favicon\\.ico|.*\\.png|.*\\.jpg|.*\\.webp).*)",
      "destination": "/"
    }
  ]
}
